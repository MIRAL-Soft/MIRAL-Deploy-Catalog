# The CatalogTool the workflows use, pinned by version and SHA-256 (C-09, S-08). Both files lie
# on https://deploy.miralsoft.com/catalogtool/<version>/; the SHA-256 values are the lines of
# SHA256SUMS in the private release of that version. Changing them is an ordinary pull request.
#
# Empty until the first release of MIRAL-Deploy is placed there: every workflow then stops and
# says so, because a check that could not run has not passed (R-23).
CATALOGTOOL_VERSION=
CATALOGTOOL_LINUX_SHA256=
CATALOGTOOL_WINDOWS_SHA256=
